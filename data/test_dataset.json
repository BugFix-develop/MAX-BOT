{
  "version": "1.0",
  "description": "Тестовый набор данных для воспроизводимой проверки математического валидатора и API",
  "test_cases": [
    {
      "id": 1,
      "category": "Разность квадратов",
      "template_id": 1,
      "task_text": "Раскройте скобки: (x - 4)(x + 4)",
      "expected_answer": "x^2-16",
      "formula": "(x - a)(x + a) = x² - a²",
      "valid_user_answers": [
        "x^2-16",
        "x^2 - 16",
        "x² - 16",
        "x2 - 16",
        "x**2 - 16",
        "х^2 - 16",
        "x в квадрате - 16",
        "x во 2 - 16"
      ],
      "invalid_user_answers": [
        "x^2 + 16",
        "x^2 - 8",
        "x - 16",
        "x^3 - 16"
      ]
    },
    {
      "id": 2,
      "category": "Квадрат суммы",
      "template_id": 8,
      "task_text": "Раскройте скобки: (x + 3)^2",
      "expected_answer": "x^2+6x+9",
      "formula": "(x + a)² = x² + 2ax + a²",
      "valid_user_answers": [
        "x^2+6x+9",
        "x^2 + 6x + 9",
        "x² + 6x + 9",
        "x2 + 6x + 9",
        "x**2 + 6*x + 9",
        "х² + 6х + 9"
      ],
      "invalid_user_answers": [
        "x^2 + 9",
        "x^2 + 3x + 9",
        "x^2 - 6x + 9"
      ]
    },
    {
      "id": 3,
      "category": "Квадрат разности",
      "template_id": 14,
