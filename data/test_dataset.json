      "formula": "(x - a)² = x² - 2ax + a²",
      "valid_user_answers": [
        "x^2-10x+25",
        "x² - 10x + 25",
        "x2 - 10x + 25",
        "x**2 - 10*x + 25"
      ],
      "invalid_user_answers": [
        "x^2 - 25",
        "x^2 + 10x + 25",
        "x^2 - 5x + 25"
      ]
    },
    {
      "id": 4,
      "category": "Формулы кубов",
      "template_id": 21,
